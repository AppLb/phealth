{% extends "layouts/base.njk" %}
{#- Страница понятия из словаря. Текст понятия — файл src/slovar/<slug>.md -#}

{% block title %}{{ title }} — словарь pHealth{% endblock %}

{% block style %}
<style>
/* Стили только страницы понятия. Общие — в assets/style.css */
.term-page{max-width:40rem;padding-block:2.5rem 3.5rem}
.term-page .back{font-size:.95rem;color:var(--muted);text-decoration:none}
.term-page .back:hover{color:var(--ink)}
.term-page .eyebrow{display:block;margin-top:1.5rem}
.term-page h1{font:900 clamp(2rem,6vw,3.2rem)/1.05 var(--display);letter-spacing:-.03em;margin:.4rem 0 1rem}
.term-page .tlead{font:400 1.25rem/1.6 var(--text);margin:0 0 1.25rem}
.term-page .body p{font:400 1.1rem/1.75 var(--text);margin:0 0 1rem}
.term-page .more{display:grid;gap:.4rem;margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--line);font:400 .95rem/1.6 var(--ui);color:var(--muted)}
.term-page .more a{font-weight:600;text-decoration:none}
.term-page .ai{margin-top:2rem;font:400 .85rem/1.5 var(--ui);color:var(--muted)}
</style>
{% endblock %}

{% block content %}
<main class="wrap">
  <article class="term-page">
    <a class="back" href="{{ '/slovar/' | rel(page.url) }}">&larr; Словарь</a>
    <span class="eyebrow">{{ group }}</span>
    <h1>{{ title }}</h1>
    <p class="tlead">{{ short }}</p>
    <div class="body">{{ content | safe }}</div>

    {%- set uses = collections.all | termUses(page.fileSlug) %}
    {%- if uses.length or related.length %}
    <div class="more">
      {%- if uses.length %}
      <span>Встречается: {% for u in uses %}<a href="{{ u.url | rel(page.url) }}">{{ u.data.title | replace(" — pHealth", "") }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>
      {%- endif %}
      {%- if related.length %}
      <span>Рядом: {% for r in related %}{% set t = collections.terms | termBySlug(r) %}{% if t %}<a href="{{ t.url | rel(page.url) }}">{{ t.data.title }}</a>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</span>
      {%- endif %}
    </div>
    {%- endif %}
    <p class="ai">Определения подготовлены с помощью нейросети. Мы их проверяем.</p>
  </article>
</main>
{% endblock %}
