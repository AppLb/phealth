---
layout: false
permalink: "/slovar/"
title: "Словарь — pHealth"
description: "Короткие объяснения понятий из разборов pHealth: как читать исследования, воздух, витамины."
---
{% extends "layouts/base.njk" %}

{% block style %}
<style>
/* Стили только страницы словаря. Общие — в assets/style.css */
.shead{display:grid;gap:.9rem;padding-block:3.5rem 0}
.shead h1{font:900 clamp(2rem,5vw,3.2rem)/1.05 var(--display);letter-spacing:-.03em;margin:0}
.shead p{margin:0;color:var(--muted);font-size:1.1rem;max-width:38rem}
.groups{padding-block:2.5rem 3.5rem}
.groups>.in{display:grid;gap:2.25rem;max-width:56rem}
.grp h2{font:700 .78rem var(--ui);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:0 0 .5rem}
.grp>div{border-top:1px solid var(--line)}
.grp details{border-bottom:1px solid var(--line);scroll-margin-top:1.5rem}
.grp summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:14rem minmax(0,1fr) 1.5rem;gap:1rem;align-items:baseline;padding:.85rem 0}
.grp summary::-webkit-details-marker{display:none}
.grp summary::after{content:"+";font:500 1.3rem/1 var(--ui);color:var(--muted);text-align:right}
.grp details[open]>summary::after{content:"–"}
.grp summary b{font:700 1rem var(--display);color:var(--ink)}
.grp summary span{color:var(--muted)}
.grp summary:hover b{color:var(--accent)}
.grp .body{padding:0 2.5rem 1.25rem 15rem;max-width:58rem}
.grp .body p{margin:0 0 .8rem;font:400 1.02rem/1.7 var(--text)}
.grp .links{display:grid;gap:.25rem;margin-top:.9rem;font:400 .92rem/1.6 var(--ui);color:var(--muted)}
.grp .links a{font-weight:600;text-decoration:none}
.grp details:target>summary b,.grp details.hit>summary b{color:var(--accent)}
.ai{font:400 .85rem/1.5 var(--ui);color:var(--muted);margin:0}
@media (max-width:720px){
  .shead{padding-top:2.5rem}
  .grp summary{grid-template-columns:minmax(0,1fr) 1.5rem;gap:.2rem 1rem}
  .grp summary span{grid-column:1}
  .grp summary::after{grid-row:1;grid-column:2}
  .grp .body{padding:0 0 1.1rem}
}
</style>
{% endblock %}

{% block content %}
<main>
<div class="wrap shead">
  <span class="eyebrow">Словарь</span>
  <h1>Понятия коротко</h1>
  <p>Что значат слова из наших разборов. Нажмите на понятие, чтобы раскрыть объяснение. В статьях такие слова подчёркнуты пунктиром.</p>
</div>
<div class="wrap groups"><div class="in">
  {%- for g in ["Как читать исследования", "Воздух", "Витамины", "Добавки"] %}
  <section class="grp">
    <h2>{{ g }}</h2>
    <div>
      {%- for t in collections.terms %}{% if t.data.group == g %}
      {%- set uses = collections.all | termUses(t.fileSlug) %}
      <details id="{{ t.fileSlug }}">
        <summary><b>{{ t.data.title }}</b><span>{{ t.data.short }}</span></summary>
        <div class="body">
          {{ t.content | safe }}
          {%- if uses.length or t.data.related.length %}
          <div class="links">
            {%- if uses.length %}<span>Встречается: {% for u in uses %}<a href="{{ u.url | rel(page.url) }}">{{ u.data.title | replace(" — pHealth", "") }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}
            {%- if t.data.related.length %}<span>Рядом: {% for r in t.data.related %}{% set rt = collections.terms | termBySlug(r) %}{% if rt %}<a href="#{{ r }}">{{ rt.data.title }}</a>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</span>{% endif %}
          </div>
          {%- endif %}
        </div>
      </details>
      {%- endif %}{% endfor %}
    </div>
  </section>
  {%- endfor %}
  <p class="ai">Определения подготовлены с помощью нейросети. Мы их проверяем.</p>
</div></div>
</main>
{% endblock %}

{% block script %}
<script>
// Ссылка вида /slovar/#ppm раскрывает нужное понятие и прокручивает к нему
(function () {
  function openHash() {
    var id = decodeURIComponent(location.hash.slice(1));
    var d = id && document.getElementById(id);
    if (!d || d.tagName !== "DETAILS") return;
    document.querySelectorAll("details.hit").forEach(function (x) { x.classList.remove("hit"); });
    d.open = true; d.classList.add("hit");
    d.scrollIntoView({ block: "start" });
  }
  addEventListener("hashchange", openHash);
  openHash();
})();
</script>
{% endblock %}
