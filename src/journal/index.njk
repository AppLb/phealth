---
title: "Журнал — pHealth"
description: "Все материалы pHealth: разборы с метками надёжности и короткие заметки."
nav: journal
---
{% extends "layouts/base.njk" %}

{% block style %}
<style>
/* Стили только страницы журнала. Общие — в assets/style.css */
section{padding-block:3.5rem}
.jhead{display:grid;gap:.9rem;padding-block:3.5rem 0}
.jhead h1{font:900 clamp(2rem,5vw,3.2rem)/1.05 var(--display);letter-spacing:-.03em;margin:0}
.jhead p{margin:0;color:var(--muted);font-size:1.1rem;max-width:36rem}
.h2{font:700 clamp(1.3rem,3vw,1.8rem)/1.15 var(--display);letter-spacing:-.02em;margin:0 0 1.5rem}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}
.card{display:grid;gap:1rem;align-content:start;padding:1.5rem;border-radius:1.25rem;background:var(--paper);border:1px solid var(--line);text-decoration:none;color:var(--ink)}
.card h3{font:700 1.3rem/1.2 var(--display);letter-spacing:-.02em;margin:0}
.card p{margin:0;color:var(--muted)}
.card:hover h3{color:var(--accent)}
.meta{display:flex;flex-wrap:wrap;gap:.4rem 1rem;font:400 .85rem var(--ui);color:var(--muted)}
.dot{display:inline-flex;align-items:center;gap:.4rem}
.dot::before{content:"";width:.55rem;height:.55rem;border-radius:50%;background:var(--c)}
.ev{display:inline-flex;align-items:center;gap:.45rem;font:500 .82rem var(--ui);white-space:nowrap}
.tally{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem 1rem;padding-top:1rem;border-top:1px solid var(--line)}
.tally .ev em{font-style:normal;color:var(--muted);margin-left:auto;font-variant-numeric:tabular-nums}
.posts{list-style:none;margin:0;padding:0;border-bottom:1px solid var(--line);max-width:46rem}
.posts li{border-top:1px solid var(--line)}
.posts details>summary{list-style:none;cursor:pointer;display:grid;gap:.4rem;padding:1.1rem 2rem 1.1rem 0;position:relative}
.posts details>summary::-webkit-details-marker{display:none}
.posts details>summary::after{content:"+";position:absolute;right:.2rem;top:1.05rem;font:500 1.3rem var(--ui);color:var(--muted)}
.posts details[open]>summary::after{content:"–"}
.posts h4{font:700 1.05rem/1.35 var(--display);letter-spacing:-.01em;margin:0}
.posts details p{margin:0 0 .9rem;max-width:38rem}
.posts details>div{padding-bottom:1.2rem}
@media (max-width:720px){
  section{padding-block:2.5rem}
  .jhead{padding-top:2.5rem}
  .cards{grid-template-columns:minmax(0,1fr)}
  .card{padding:1.25rem}
  .cover{height:6.5rem}
  .card h3{font-size:1.15rem}
  .tally{gap:.5rem .6rem}
  .ev{font-size:.76rem;gap:.35rem}
}
</style>
{% endblock %}

{% block content %}
<main>
<div class="wrap jhead">
  <span class="eyebrow">Журнал</span>
  <h1>Все материалы</h1>
  <p>Разборы с метками надёжности и короткие заметки. Новые сверху.</p>
</div>

<section>
  <div class="wrap">
    <h2 class="h2">Разборы</h2>
    <div class="cards">
      {%- for a in collections.articles %}
      {%- set counts = a.inputPath | tally %}
      <a class="card" href="{{ a.url | rel(page.url) }}">
        <div class="cover">{{ a.inputPath | coverSvg | safe }}<b>{{ a.data.cover }}</b><span>Разбор</span></div>
        <div class="meta"><span>{{ a.date | ruDate }}</span><span class="dot" style="--c:{{ topics[a.data.topic] }}">{{ a.data.topic }}</span><span>{{ a.data.author }}</span><span>{{ a.inputPath | readMin }} мин чтения</span></div>
        <h3>{{ a.data.title }}</h3>
        <p>{{ a.data.teaser }}</p>
        <div class="tally" aria-label="Метки в статье">
          {%- for l, name in { "4": "Сильные", "3": "Умеренные", "2": "Ограниченные", "1": "Не подтверждено" } | dictsort | reverse %}
          <span class="ev" data-l="{{ l }}"><span class="m"><b></b><b></b><b></b><b></b></span>{{ name }}<em>{{ counts[l] }}</em></span>
          {%- endfor %}
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap">
    <h2 class="h2">Короткие заметки</h2>
    <ul class="posts">
      {%- for n in collections.notes %}
      <li><details><summary><span class="meta"><span>{{ n.date | ruDay }}</span><span class="dot" style="--c:{{ topics[n.data.topic] }}">{{ n.data.topic }}</span></span><h4>{{ n.data.title }}</h4></summary><div>{{ n.content | safe }}</div></details></li>
      {%- endfor %}
    </ul>
  </div>
</section>
</main>
{% endblock %}
